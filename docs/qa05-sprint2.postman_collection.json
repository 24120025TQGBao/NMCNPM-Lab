  "item": [
    {
      "name": "S2-01 guest suggestion",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/suggestions?limit=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Data envelope\", () => pm.expect(body).to.have.property(\"data\"));",
              "pm.test(\"At most one dish\", () => { pm.expect(body.data).to.be.an(\"array\"); pm.expect(body.data.length).to.be.at.most(1); });"
            ]
          }
        }
      ]
    },
    {
      "name": "S2-01 excludes viewed dish",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/suggestions?exclude={{dishId}}&limit=5"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.variables.get(\"dishId\") || String(pm.variables.get(\"dishId\")).startsWith(\"SET_\")) throw new Error(\"Configure dishId from QA dataset before running\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Data envelope\", () => pm.expect(body).to.have.property(\"data\"));",
              "pm.test(\"Excluded ID absent\", () => pm.expect(body.data.map(x => String(x.id))).not.to.include(String(pm.variables.get(\"dishId\"))));"
            ]
          }
        }
      ]
    },
    {
      "name": "S2-01 random respects tag",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/suggestions?random=true&the=TROI_MUA&limit=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Data envelope\", () => pm.expect(body).to.have.property(\"data\"));",
              "pm.test(\"Tag preserved\", () => body.data.forEach(x => pm.expect(x.tags).to.include(\"TROI_MUA\")));"
            ]
          }
        }
      ]
    },
