# Cổng backend (khớp Vite proxy của frontend)
PORT=3000
NODE_ENV=development

# Supabase: lấy ở Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co

# Khóa CÔNG KHAI (anon/publishable): dùng để xác minh token và truy vấn theo quyền người dùng (RLS)
SUPABASE_ANON_KEY=your-anon-key-here

# Khóa service role: BỎ QUA RLS, chỉ dùng ở backend, TUYỆT ĐỐI không đưa vào frontend hoặc biến VITE_.
# Hiện chưa dùng, chỉ thêm khi nhóm (TV3) thống nhất. Không commit giá trị thật.
# SUPABASE_SERVICE_ROLE_KEY=

# Origin frontend được phép gọi API, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://localhost:3000