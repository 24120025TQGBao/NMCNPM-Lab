# Cổng backend (khớp Vite proxy của frontend)
PORT=3000
NODE_ENV=development

# Supabase: lấy ở Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co

# Khóa CÔNG KHAI (anon/publishable): dùng để xác minh token và truy vấn theo quyền người dùng (RLS)
SUPABASE_ANON_KEY=your-anon-key-here

# Chỉ cần cho GET /api/dishes vì RPC search_public_dishes chỉ cấp quyền service_role.
# Khóa này bỏ qua RLS: chỉ cấu hình ở backend/Vercel, tuyệt đối không dùng ở frontend hoặc commit giá trị thật.
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-key

# Origin frontend được phép gọi API, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://localhost:3000