VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Empty locally; use deployed backend origin on Vercel (no trailing slash).
VITE_API_URL=
# Dev only: true dùng mock cho bài đăng và luồng /search -> món -> công thức.
# Bị bỏ qua hoàn toàn ở bản build production.
# Lookup dishes.list (ô chọn món khi đăng bài) và GET /api/me luôn gọi backend thật.
VITE_USE_MOCK=false
# Bật/tắt mock cho hai tab gợi ý (FE07-FE09: /api/suggestions, /api/ingredients, /api/dishes/match). Mặc định bật (true) cho đến khi backend Sprint 2 sẵn sàng.
VITE_USE_MOCK_API=true
