VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Empty locally; use deployed backend origin on Vercel (no trailing slash).
VITE_API_URL=
# Dev only: true thì các endpoint CHƯA có trên backend thật (bài đăng, bình luận, báo cáo, quản trị...)
# dùng dữ liệu mẫu trong bộ nhớ. Bị bỏ qua hoàn toàn ở bản build production.
# GET /api/dishes và GET /api/me luôn gọi backend thật.
VITE_USE_MOCK=false
